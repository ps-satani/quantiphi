PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# GitHub personal access token (classic or fine-grained, no scopes needed for public data).
# Without it the app falls back to the REST API (60 req/hour, no full contribution calendar).
GITHUB_TOKEN=

# SQLite file location and how long cached GitHub data stays fresh (seconds)
DB_PATH=./data/portfolio.db
CACHE_TTL_SECONDS=3600

# Optional: AI features (portfolio chatbot + recruiter pitch). Any OpenAI-compatible API, Groq by default.
# Leave LLM_API_KEY empty to use the built-in rule-based answers.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
