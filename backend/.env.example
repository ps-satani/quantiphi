PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# GitHub personal access token (classic or fine-grained, no scopes needed for public data).
# Without it the app falls back to the REST API (60 req/hour, no full contribution calendar).
GITHUB_TOKEN=

# SQLite file location and how long cached GitHub data stays fresh (seconds)
DB_PATH=./data/portfolio.db
CACHE_TTL_SECONDS=3600
